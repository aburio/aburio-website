---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { faArrowLeft } from "@fortawesome/free-solid-svg-icons/faArrowLeft";
import { faArrowRight } from "@fortawesome/free-solid-svg-icons/faArrowRight";
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Figure from "../../components/Figure.astro";
import Icon from "../../components/Icon.astro";
import Media from "../../components/Media.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Tag from "../../components/Tag.astro";
import { expectedPath, findImage } from "../../lib/media";
import { site } from "../../lib/site";

export const getStaticPaths = (async () => {
  const featured = (await getCollection("work", (entry) => entry.data.featured)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return featured.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: featured[(i + 1) % featured.length] },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const { title, client, period, role, keyFigure, tags, stack, liveUrl, coverAlt, gallery, summary } =
  entry.data;
const { Content } = await render(entry);
const liveHost = liveUrl ? new URL(liveUrl).hostname.replace(/^www\./, "") : undefined;
---

<Base title={`${title}, ${client} — ${site.name}`} description={summary}>
  <article class="case">
    <header class="case__header">
      <a class="back-link small" href="/#work">
        <Icon icon={faArrowLeft} />
        All work
      </a>
      <p class="subtitle">{client}</p>
      <h1 class="display">{title}</h1>
      {keyFigure && <p class="case__figure">{keyFigure}</p>}
      <div class="ab-tags">
        {tags.map((tag, i) => <Tag accent={i === 0}>{tag}</Tag>)}
      </div>
    </header>

    <dl class="case__facts">
      <div>
        <dt class="small faint">Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt class="small faint">Period</dt>
        <dd>{period}</dd>
      </div>
      {
        stack.length > 0 && (
          <div>
            <dt class="small faint">Stack</dt>
            <dd class="stack">{stack.join(", ")}</dd>
          </div>
        )
      }
      {
        liveUrl && (
          <div>
            <dt class="small faint">Live</dt>
            <dd>
              <a class="ab-link" href={liveUrl} target="_blank" rel="noopener">
                {liveHost}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </dd>
          </div>
        )
      }
    </dl>

    <Media
      image={findImage("work", entry.id, "cover")}
      alt={coverAlt}
      widths={[480, 640, 960, 1280, 1600]}
      sizes="(max-width: 960px) calc(100vw - 24px), 936px"
      eager
      expected={expectedPath("work", entry.id, "cover")}
    />

    <div class="prose">
      <Content />
    </div>

    {
      gallery && gallery.length > 0 && (
        <section aria-labelledby="screens">
          <SectionHeading id="screens">Screens</SectionHeading>
          <div class="gallery">
            {gallery.map((item) => (
              <Figure slug={entry.id} item={item} />
            ))}
          </div>
        </section>
      )
    }

    <nav class="case__footer" aria-label="Case study">
      {
        liveUrl && (
          <Button href={liveUrl} icon={faArrowUpRightFromSquare} external>
            Visit {liveHost}
          </Button>
        )
      }
      {
        next.id !== entry.id && (
          <a class="next-link" href={`/work/${next.id}/`}>
            <span class="small faint">Next case study</span>
            <span class="next-link__title">
              {next.data.title}
              <Icon icon={faArrowRight} />
            </span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-4) var(--space-5);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--link);
  }

  .case__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case__figure {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--divider);
  }

  dd {
    margin: 0;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--code-size);
    line-height: var(--code-line);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .prose :global(p) {
    max-width: 68ch;
  }

  .prose :global(.ab-section) {
    margin: var(--space-5) 0 0;
  }

  .prose :global(.ab-section:first-child) {
    margin-top: 0;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--divider);
  }

  .next-link {
    display: flex;
    flex-direction: column;
    margin-left: auto;
    color: var(--text);
    text-align: right;
    text-decoration: none;
  }

  .next-link__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
    transition: color 0.15s;
  }

  .next-link:hover .next-link__title {
    color: var(--link);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .next-link__title {
      transition: none;
    }
  }
</style>
