---
import { getEntry } from "astro:content";
import { faArrowLeft } from "@fortawesome/free-solid-svg-icons/faArrowLeft";
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import Media from "../../components/Media.astro";
import { expectedPath, findImage } from "../../lib/media";
import { site } from "../../lib/site";

const entry = await getEntry("bicytrust", "bicytrust");
if (!entry) throw new Error("Missing src/content/bicytrust/bicytrust.md");
const { title, role, period, intro, stack, liveUrl, gallery } = entry.data;
const liveHost = new URL(liveUrl).hostname.replace(/^www\./, "");
const anchor = (text: string) => `shot-${text.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<Base title={`${title} - ${site.name}`} description={intro}>
  <article class="case">
    <header class="case__header">
      <a class="back-link small" href="/#work">
        <Icon icon={faArrowLeft} />
        Back to home
      </a>
      <h1 class="display">{title}</h1>
      <p class="subtitle">{role}</p>
      <p class="case__intro">{intro}</p>
    </header>

    <dl class="facts">
      <div>
        <dt class="small faint">Period</dt>
        <dd>{period}</dd>
      </div>
      <div class="facts__stack">
        <dt class="small faint">Stack</dt>
        <dd class="stack">{stack.join(", ")}</dd>
      </div>
      <div>
        <dt class="small faint">Live</dt>
        <dd>
          <a class="ab-link" href={liveUrl} target="_blank" rel="noopener">
            {liveHost}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </dd>
      </div>
    </dl>

    <div class="gallery">
      {
        gallery.map((item) => (
          <section class="shot" aria-labelledby={anchor(item.title)}>
            <div class="shot__text">
              <h2 class="shot__title" id={anchor(item.title)}>
                {item.title}
              </h2>
              <p>{item.text}</p>
            </div>
            {item.image && (
              <Media
                image={findImage("work", "bicytrust", item.image)}
                alt={item.alt ?? ""}
                widths={[480, 640, 960, 1280, 1600]}
                sizes="(max-width: 960px) calc(100vw - 24px), 936px"
                expected={expectedPath("work", "bicytrust", item.image)}
              />
            )}
          </section>
        ))
      }
    </div>

    <footer class="case__footer">
      <Button href={liveUrl} icon={faArrowUpRightFromSquare} external>
        Visit {liveHost}
      </Button>
      <a class="back-link" href="/#experience">See my experience</a>
    </footer>
  </article>
</Base>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-4) var(--space-5);
  }

  .case__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .case__header .back-link {
    margin-bottom: var(--space-4);
  }

  .back-link:hover {
    color: var(--link);
  }

  .case__intro {
    margin-top: var(--space-3);
    max-width: 68ch;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: var(--space-4) var(--space-5);
    margin: 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--divider);
  }

  dd {
    margin: 0;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--code-size);
    line-height: var(--code-line);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .shot {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .shot__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 68ch;
  }

  .shot__title {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
  }

  .case__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--divider);
  }

  @media (max-width: 767px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link {
      transition: none;
    }
  }
</style>
