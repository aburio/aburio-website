---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkCard from "../components/WorkCard.astro";
import WorkCardCompact from "../components/WorkCardCompact.astro";
import SideProjectCard from "../components/SideProjectCard.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { site } from "../lib/site";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const work = (await getCollection("work")).sort(byOrder);
const selected = work.filter((entry) => entry.data.featured);
const earlier = work.filter((entry) => !entry.data.featured);
const sideProjects = (await getCollection("side-projects")).sort(byOrder);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.jobTitle,
  url: site.url,
  sameAs: [site.linkedin, site.github],
};
---

<Base title={`${site.name} — ${site.jobTitle}`} description={site.tagline} jsonLd={jsonLd}>
  <Hero />

  <section class="page-section" aria-labelledby="work">
    <SectionHeading id="work">Selected work</SectionHeading>
    <div class="card-list">
      {
        selected.map((entry, i) => (
          <>
            {i > 0 && <hr class="ab-rule" />}
            <WorkCard entry={entry} eager={i === 0} />
          </>
        ))
      }
    </div>
  </section>

  <About />

  <section class="page-section" aria-labelledby="earlier-work">
    <SectionHeading id="earlier-work">Earlier work</SectionHeading>
    <div class="card-list">
      {
        earlier.map((entry, i) => (
          <>
            {i > 0 && <hr class="ab-rule" />}
            <WorkCardCompact entry={entry} />
          </>
        ))
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="side-projects">
    <SectionHeading id="side-projects">Side projects</SectionHeading>
    <div class="card-list">
      {
        sideProjects.map((entry, i) => (
          <>
            {i > 0 && <hr class="ab-rule" />}
            <SideProjectCard entry={entry} />
          </>
        ))
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="contact">
    <SectionHeading id="contact">Contact</SectionHeading>
    <p class="contact-text">
      Always happy to talk with founders and startup studios building product-led companies.
    </p>
    <ContactLinks />
  </section>
</Base>

<style>
  .card-list :global(.ab-rule) {
    margin-block: var(--space-5);
  }

  .contact-text {
    margin-bottom: var(--space-4);
  }
</style>
