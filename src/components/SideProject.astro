---
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Icon from "./Icon.astro";
import Media from "./Media.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";
import { contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, cover, links } = project.data;
const link = links[0];
// The link names where it goes, so a visitor knows they are leaving the site.
const linkText = link
  ? link.url.includes("github.com")
    ? "View on GitHub"
    : `Visit ${new URL(link.url).hostname.replace(/^www\./, "")}`
  : undefined;
---

<article class="side" aria-labelledby={`project-${project.id}`}>
  <div class="side__thumb">
    <Media
      image={cover && findImage(project.id, "cover")}
      video={cover && findVideo(project.id, "cover")}
      alt={cover?.alt ?? ""}
      widths={[128, 256]}
      sizes="128px"
      ratio="16 / 10"
      small
      expected={cover && expectedPath(project.id, "cover")}
    />
  </div>
  <div class="side__name">
    <h3 class="side__title" id={`project-${project.id}`}>{title}</h3>
    <span class="small muted">{contextLine(project.data)}</span>
  </div>
  <p class="side__text">{summary}</p>
  {
    link && (
      <a class="ab-link side__link" href={link.url} target="_blank" rel="noopener">
        {linkText}
        <Icon icon={faArrowUpRightFromSquare} />
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    )
  }
</article>

<style>
  .side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) 32px;
    margin-inline: calc(var(--space-4) * -1);
    padding: 20px var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.15s;
  }

  .side:hover {
    background: var(--surface);
  }

  .side__thumb {
    flex: 0 0 128px;
  }

  .side__name {
    flex: 2 1 200px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .side__title {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
  }

  .side__text {
    flex: 4 1 320px;
    min-width: 0;
  }

  .side__link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .side__link :global(.icon) {
    font-size: 13px;
  }

  @media (prefers-reduced-motion: reduce) {
    .side {
      transition: none;
    }
  }
</style>
