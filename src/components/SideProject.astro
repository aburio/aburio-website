---
import ExternalLink from "./ExternalLink.astro";
import Media from "./Media.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";
import { contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, cover, links } = project.data;
const link = links[0];
// The link names where it goes, so a visitor knows they are leaving the site.
const linkText = link
  ? link.url.includes("github.com")
    ? "View on GitHub"
    : `Visit ${new URL(link.url).hostname.replace(/^www\./, "")}`
  : undefined;
---

<article class="side" aria-labelledby={`project-${project.id}`}>
  <div class="side__thumb">
    <Media
      image={cover && findImage(project.id, "cover")}
      video={cover && findVideo(project.id, "cover")}
      alt={cover?.alt ?? ""}
      widths={[128, 256, 480, 640, 960]}
      sizes="(max-width: 599px) calc(100vw - 48px), 128px"
      ratio="16 / 10"
      small
      expected={cover && expectedPath(project.id, "cover")}
    />
  </div>
  <div class="side__name">
    <h3 class="side__title" id={`project-${project.id}`}>{title}</h3>
    <span class="small muted">{contextLine(project.data)}</span>
  </div>
  <p class="side__text">{summary}</p>
  {
    link && (
      <span class="side__link">
        <ExternalLink href={link.url}>{linkText}</ExternalLink>
      </span>
    )
  }
</article>

<style>
  .side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) 32px;
    padding-block: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .side__thumb {
    flex: 0 0 128px;
  }

  .side__name {
    flex: 2 1 200px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .side__title {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
  }

  .side__text {
    flex: 4 1 320px;
    min-width: 0;
  }

  .side__link {
    flex: 0 0 auto;
  }

  /* On a phone the thumbnail is too small to read: stack the row and give it the full width. */
  @media (max-width: 599px) {
    .side {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: var(--space-2);
      padding-block: var(--space-5);
    }

    .side__thumb,
    .side__name,
    .side__text {
      flex: none;
    }

    .side__thumb {
      width: 100%;
      margin-bottom: var(--space-2);
    }

    .side__link {
      margin-top: var(--space-1);
    }
  }
</style>
