---
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Button from "./Button.astro";
import Media from "./Media.astro";
import Tag from "./Tag.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";
import { caseStudyUrl, contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, figures, tags, cover, links } = project.data;
const href = caseStudyUrl(project);
const live = links.find((link) => link.url.startsWith("http"));
---

<article class="featured hover-card" aria-labelledby={`project-${project.id}`}>
  <div class="featured__media">
    {
      cover && (
        <Media
          image={findImage(project.id, "cover")}
          video={findVideo(project.id, "cover")}
          alt={cover.alt}
          widths={[480, 640, 960, 1280]}
          sizes="(max-width: 767px) calc(100vw - 24px), 560px"
          ratio="16 / 10"
          eager
          expected={expectedPath(project.id, "cover")}
        />
      )
    }
  </div>
  <div class="featured__text">
    <div class="ab-tags">
      {tags.map((tag, i) => <Tag accent={i === 0}>{tag}</Tag>)}
    </div>
    <h3 class="featured__title" id={`project-${project.id}`}>
      <a class="card-link" href={href}>{title}</a>
    </h3>
    <p class="small muted">{contextLine(project.data)}</p>
    <p>{summary}</p>
    {
      figures && (
        <ul class="featured__figures">
          {figures.map((figure) => (
            <li>
              <span class="featured__value">{figure.value}</span>
              <span class="small muted">{figure.label}</span>
            </li>
          ))}
        </ul>
      )
    }
    <div class="featured__actions above-card-link">
      <Button href={href} duplicate>Case study</Button>
      {
        live && (
          <Button
            href={live.url}
            variant="secondary"
            icon={faArrowUpRightFromSquare}
            external
            ariaLabel={`${live.label}: ${project.data.org} (opens in a new tab)`}
          >
            {live.label}
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .featured {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3.4vw, 32px) 32px;
    padding: var(--space-4) 0 clamp(32px, 5vw, 48px);
    border-bottom: 1px solid var(--divider);
  }

  .featured__media {
    flex: 3 1 420px;
    min-width: 0;
  }

  .featured__text {
    flex: 2 1 300px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .featured__title {
    font-size: 32px;
    line-height: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .featured__figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--divider);
    list-style: none;
  }

  .featured__figures li {
    display: flex;
    flex-direction: column;
  }

  .featured__value {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: 700;
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
