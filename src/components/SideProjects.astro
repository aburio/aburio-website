---
import { getCollection } from "astro:content";
import { faGithub } from "@fortawesome/free-brands-svg-icons/faGithub";
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Button from "./Button.astro";
import Media from "./Media.astro";
import SectionHeading from "./SectionHeading.astro";
import Tag from "./Tag.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";

const projects = (await getCollection("side-projects")).sort((a, b) => a.data.order - b.data.order);
---

<section class="page-section" aria-labelledby="side-projects">
  <SectionHeading id="side-projects">Side projects</SectionHeading>
  <ul class="grid">
    {
      projects.map((project) => {
        const { title, subtitle, text, figure, tags, cover, coverAlt, linkLabel, linkUrl } =
          project.data;
        return (
          <li class="project">
            {cover ? (
              <Media
                image={findImage("side-projects", project.id, "cover")}
                video={findVideo("side-projects", project.id, "cover")}
                alt={coverAlt ?? ""}
                widths={[320, 480, 640, 854, 960]}
                sizes="(max-width: 767px) calc(100vw - 24px), 462px"
                expected={expectedPath("side-projects", project.id, "cover")}
              />
            ) : (
              // Aburio has no logo by design: the name set in type stands in for one.
              <div class="wordmark" aria-hidden="true">
                <span class="wordmark__name">{title}</span>
              </div>
            )}
            <h3 class="project__title">{title}</h3>
            <p class="muted">{subtitle}</p>
            <p>{text}</p>
            {figure && <p class="project__figure">{figure}</p>}
            <div class="ab-tags">
              {tags.map((tag, i) => (
                <Tag accent={i === 0}>{tag}</Tag>
              ))}
            </div>
            {linkUrl && linkLabel && (
              <div class="project__action">
                <Button
                  href={linkUrl}
                  size="sm"
                  variant="secondary"
                  icon={linkUrl.includes("github.com") ? faGithub : faArrowUpRightFromSquare}
                  external
                  ariaLabel={`${linkLabel}: ${title} (opens in a new tab)`}
                >
                  {linkLabel}
                </Button>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project > :global(.media),
  .wordmark {
    margin-bottom: var(--space-2);
  }

  .wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  /* Not the display style: the page keeps its one display for the hero. */
  .wordmark__name {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: 700;
    letter-spacing: var(--display-tracking);
  }

  .project__title {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: var(--heading-weight);
  }

  .project__figure {
    font-weight: var(--body-strong-weight);
  }

  .project__action {
    margin-top: var(--space-2);
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
