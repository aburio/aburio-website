---
import Media from "./Media.astro";
import { expectedPath, findImage } from "../lib/media";

type Single = { image: string; alt: string; caption: string };
type Compare = { before: string; after: string; beforeAlt: string; afterAlt: string; caption: string };

interface Props {
  slug: string;
  item: Single | Compare;
}

const { slug, item } = Astro.props;
const widths = [480, 640, 960, 1280, 1600];
const fullSizes = "(max-width: 960px) calc(100vw - 24px), 936px";
const halfSizes = "(max-width: 767px) calc(100vw - 24px), 462px";
---

<figure class="figure">
  {
    "image" in item ? (
      <Media
        image={findImage("work", slug, item.image)}
        alt={item.alt}
        widths={widths}
        sizes={fullSizes}
        expected={expectedPath("work", slug, item.image)}
      />
    ) : (
      <div class="compare">
        <div class="compare__side">
          <Media
            image={findImage("work", slug, item.before)}
            alt={item.beforeAlt}
            widths={widths}
            sizes={halfSizes}
            expected={expectedPath("work", slug, item.before)}
          />
          <p class="compare__label small muted">Before</p>
        </div>
        <div class="compare__side">
          <Media
            image={findImage("work", slug, item.after)}
            alt={item.afterAlt}
            widths={widths}
            sizes={halfSizes}
            expected={expectedPath("work", slug, item.after)}
          />
          <p class="compare__label small muted">After</p>
        </div>
      </div>
    )
  }
  <figcaption class="small muted">{item.caption}</figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .compare__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .compare__label {
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
</style>
