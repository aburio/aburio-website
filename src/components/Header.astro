---
import { faMoon } from "@fortawesome/free-solid-svg-icons/faMoon";
import { faSun } from "@fortawesome/free-solid-svg-icons/faSun";
import Icon from "./Icon.astro";
import { site } from "../lib/site";

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: "/#side-projects", label: "Side projects" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header container">
  <a class="site-name" href="/">{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme">
    <Icon icon={faMoon} class="theme-toggle__moon" />
    <Icon icon={faSun} class="theme-toggle__sun" />
  </button>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function isDark() {
    const explicit = document.documentElement.dataset.theme;
    return explicit ? explicit === "dark" : media.matches;
  }

  function sync() {
    toggle?.setAttribute("aria-pressed", String(isDark()));
  }

  toggle?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    // Storage can throw in private mode; the toggle still works for this page.
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });

  media.addEventListener("change", sync);
  sync();
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
  }

  .site-name {
    margin-right: auto;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  nav a:hover,
  .site-name:hover {
    color: var(--link);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--secondary);
    color: var(--secondary-text);
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .theme-toggle:hover {
    background: var(--secondary-hover);
  }

  .theme-toggle :global(.theme-toggle__sun) {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__sun) {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.theme-toggle__moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.theme-toggle__sun) {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme-toggle :global(.theme-toggle__moon) {
      display: none;
    }
  }

  @media (max-width: 479px) {
    nav {
      order: 3;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a,
    .theme-toggle {
      transition: none;
    }
  }
</style>
