---
import ArrowIcon from "./ArrowIcon.astro";
import Media from "./Media.astro";
import Tag from "./Tag.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";
import { caseStudyUrl, contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
  // The lead project spans the grid: same card, more room.
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { title, summary, figure, figures, tags, cover } = project.data;
const figureLine = figure ?? figures?.map((f) => `${f.value} ${f.label}`).join(" · ");
---

<article
  class:list={["card hover-card", { "card--wide": wide }]}
  aria-labelledby={`project-${project.id}`}
>
  {
    cover && (
      <Media
        image={findImage(project.id, "cover")}
        video={findVideo(project.id, "cover")}
        alt={cover.alt}
        widths={wide ? [480, 640, 960, 1280, 1600] : [320, 480, 640, 960]}
        sizes={
          wide
            ? "(max-width: 960px) calc(100vw - 24px), 936px"
            : "(max-width: 799px) calc(100vw - 24px), 456px"
        }
        eager={wide}
        expected={expectedPath(project.id, "cover")}
      />
    )
  }
  <div class="card__head">
    <h3 class="card__title" id={`project-${project.id}`}>
      <a class="card-link" href={caseStudyUrl(project)}>{title}</a>
    </h3>
    <ArrowIcon size="20px" />
  </div>
  <p class="small muted">{contextLine(project.data)}</p>
  <p>{summary}</p>
  {figureLine && <p class="card__figure">{figureLine}</p>}
  <div class="ab-tags">
    {tags.map((tag, i) => <Tag accent={i === 0}>{tag}</Tag>)}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .card > :global(.media) {
    margin-bottom: var(--space-2);
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .card__head :global(.arrow) {
    margin-top: 4px;
  }

  .card__title {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: 500;
  }

  .card__figure {
    font-weight: var(--body-strong-weight);
  }
</style>
