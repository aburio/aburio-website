---
import ArrowIcon from "./ArrowIcon.astro";
import Media from "./Media.astro";
import Tag from "./Tag.astro";
import { expectedPath, findImage, findVideo } from "../lib/media";
import { caseStudyUrl, contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, figure, tags, cover } = project.data;
---

<article class="card hover-card" aria-labelledby={`project-${project.id}`}>
  {
    cover && (
      <Media
        image={findImage(project.id, "cover")}
        video={findVideo(project.id, "cover")}
        alt={cover.alt}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 799px) calc(100vw - 24px), 456px"
        expected={expectedPath(project.id, "cover")}
      />
    )
  }
  <div class="card__head">
    <h3 class="card__title" id={`project-${project.id}`}>
      <a class="card-link" href={caseStudyUrl(project)}>{title}</a>
    </h3>
    <ArrowIcon size="20px" />
  </div>
  <p class="small muted">{contextLine(project.data)}</p>
  <p>{summary}</p>
  {figure && <p class="card__figure">{figure}</p>}
  <div class="ab-tags">
    {tags.map((tag, i) => <Tag accent={i === 0}>{tag}</Tag>)}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .card > :global(.media) {
    margin-bottom: var(--space-2);
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .card__head :global(.arrow) {
    margin-top: 4px;
  }

  .card__title {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: 500;
  }

  .card__figure {
    font-weight: var(--body-strong-weight);
  }
</style>
