---
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Button from "./Button.astro";
import Media from "./Media.astro";
import { expectedPath, findImage } from "../lib/media";
import { caseStudyUrl, contextLine, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, figures, cover, links } = project.data;
const href = caseStudyUrl(project);
const live = links.find((link) => link.url.startsWith("http"));
---

<article class="featured" aria-labelledby={`project-${project.id}`}>
  {
    cover && (
      <Media
        image={findImage(project.id, "cover")}
        alt={cover.alt}
        widths={[480, 640, 960, 1280, 1600]}
        sizes="(max-width: 960px) calc(100vw - 24px), 936px"
        expected={expectedPath(project.id, "cover")}
      />
    )
  }
  <div class="featured__text">
    <h3 class="featured__title" id={`project-${project.id}`}>
      <a href={href}>{title}</a>
    </h3>
    <p class="small muted">{contextLine(project.data)}</p>
    <p class="featured__summary">{summary}</p>
  </div>
  {
    figures && (
      <ul class="figures">
        {figures.map((figure) => (
          <li>
            <span class="figures__value">{figure.value}</span>
            <span class="muted">{figure.label}</span>
          </li>
        ))}
      </ul>
    )
  }
  <div class="featured__actions">
    <Button href={href} duplicate>Case study</Button>
    {
      live && (
        <Button
          href={live.url}
          variant="secondary"
          icon={faArrowUpRightFromSquare}
          external
          ariaLabel={`${live.label}: ${project.data.org} (opens in a new tab)`}
        >
          {live.label}
        </Button>
      )
    }
  </div>
</article>

<style>
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .featured__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .featured__title {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: var(--title-weight);
  }

  .featured__title a,
  .featured__title a:visited {
    color: inherit;
    text-decoration: none;
  }

  .featured__title a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .featured__summary {
    max-width: 65ch;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--divider);
    list-style: none;
  }

  .figures li {
    display: flex;
    flex-direction: column;
  }

  .figures__value {
    font-size: var(--title-size);
    line-height: var(--title-line);
    font-weight: 700;
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
