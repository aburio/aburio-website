---
import type { CollectionEntry } from "astro:content";
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons/faArrowUpRightFromSquare";
import Button from "./Button.astro";
import Media from "./Media.astro";
import Tag from "./Tag.astro";
import { expectedPath, findImage } from "../lib/media";

interface Props {
  entry: CollectionEntry<"work">;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const { title, client, period, summary, keyFigure, tags, liveUrl, coverAlt } = entry.data;
const href = `/work/${entry.id}/`;
const headingId = `work-${entry.id}`;
---

<article class="ab-card" aria-labelledby={headingId}>
  <Media
    image={findImage("work", entry.id, "cover")}
    alt={coverAlt}
    widths={[320, 480, 640, 960]}
    sizes="(max-width: 767px) calc(100vw - 24px), 304px"
    eager={eager}
    expected={expectedPath("work", entry.id, "cover")}
  />
  <div class="ab-card__body">
    <h3 class="ab-card__title" id={headingId}>
      <a href={href}>{title}</a>
    </h3>
    <p class="small faint">{client} · {period}</p>
    <p class="ab-card__text">{summary}</p>
    {keyFigure && <p class="key-figure">{keyFigure}</p>}
    <div class="ab-tags">
      {tags.map((tag, i) => <Tag accent={i === 0}>{tag}</Tag>)}
    </div>
    <div class="card-actions">
      <Button href={href} size="sm" ariaLabel={`Case study: ${title}`}>Case study</Button>
      {
        liveUrl && (
          <Button
            href={liveUrl}
            size="sm"
            variant="secondary"
            icon={faArrowUpRightFromSquare}
            external
            ariaLabel={`Live site: ${client} (opens in a new tab)`}
          >
            Live site
          </Button>
        )
      }
    </div>
  </div>
</article>

<style>
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .key-figure {
    font-size: var(--body-strong-size);
    line-height: var(--body-strong-line);
    font-weight: var(--body-strong-weight);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
