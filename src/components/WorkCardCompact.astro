---
import type { CollectionEntry } from "astro:content";
import { faFilePdf } from "@fortawesome/free-solid-svg-icons/faFilePdf";
import Button from "./Button.astro";
import Media from "./Media.astro";
import { expectedPath, findFile, findImage, findVideo } from "../lib/media";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, client, summary, keyFigure, coverAlt, document } = entry.data;
const documentUrl = document && findFile("work", entry.id, document.file);
---

<article class="ab-card">
  <Media
    image={findImage("work", entry.id, "cover")}
    video={findVideo("work", entry.id, "cover")}
    alt={coverAlt}
    widths={[320, 480, 640, 960]}
    sizes="(max-width: 767px) calc(100vw - 24px), 304px"
    expected={expectedPath("work", entry.id, "cover")}
  />
  <div class="ab-card__body">
    <h3 class="ab-card__title">{title}</h3>
    <p class="small faint">{client}</p>
    <p class="ab-card__text">{summary}</p>
    {keyFigure && <p class="key-figure">{keyFigure}</p>}
    {
      document && documentUrl && (
        <div class="card-actions">
          <Button href={documentUrl} size="sm" variant="secondary" icon={faFilePdf} external>
            {document.label}
          </Button>
        </div>
      )
    }
  </div>
</article>

<style>
  .key-figure {
    font-size: var(--body-strong-size);
    line-height: var(--body-strong-line);
    font-weight: var(--body-strong-weight);
  }

  .card-actions {
    margin-top: var(--space-2);
  }
</style>
