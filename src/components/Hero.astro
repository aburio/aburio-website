---
import { Picture } from "astro:assets";
import portrait from "../assets/about/portrait.webp";
import ContactLinks from "./ContactLinks.astro";
import { disciplines, site } from "../lib/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__id rise">
    <Picture
      class="hero__portrait"
      src={portrait}
      alt={`Portrait of ${site.name}`}
      widths={[64, 128, 192]}
      sizes="64px"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading="eager"
    />
    <div class="hero__name">
      <span class="hero__name-main">{site.name}</span>
      <span class="subtitle">{site.jobTitle}</span>
    </div>
  </div>

  <h1 id="hero-title" class="hero__title rise" style="animation-delay: 0.1s">
    <span aria-hidden="true">
      I build products end to end:{" "}
      <span class="cycle">
        {
          disciplines.map((word) => (
            <span>
              <span class="cycle__word">{word}.</span>
            </span>
          ))
        }
      </span>
      <span class="cycle-static">{disciplines.join(", ")}.</span>
    </span>
    <span class="visually-hidden">{site.tagline}</span>
  </h1>

  <p class="hero__bio rise" style="animation-delay: 0.2s">{site.bio}</p>

  <div class="rise" style="animation-delay: 0.3s">
    <ContactLinks />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3.4vw, 32px);
    padding-block: clamp(40px, 10vw, 96px) clamp(40px, 7.5vw, 72px);
  }

  .hero__id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__portrait {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .hero__name {
    display: flex;
    flex-direction: column;
  }

  .hero__name-main {
    font-weight: 500;
  }

  /* Larger than the Aburio display style on purpose: the sentence is the page's statement. */
  .hero__title {
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero__bio {
    color: var(--text-muted);
    font-size: 20px;
    line-height: 30px;
  }

  /* The words stack in one grid cell, so the slot is as wide as the longest word
     and stays on the sentence's line when there is room. */
  .cycle {
    display: inline-grid;
    vertical-align: bottom;
  }

  .cycle > span {
    grid-area: 1 / 1;
    opacity: 0;
    white-space: nowrap;
    animation: word 10s var(--ease-out) infinite;
  }

  .cycle > span:nth-child(2) { animation-delay: 2.5s; }
  .cycle > span:nth-child(3) { animation-delay: 5s; }
  .cycle > span:nth-child(4) { animation-delay: 7.5s; }

  .cycle__word {
    padding: 0 0.15em;
    border-radius: var(--radius-md);
    background: var(--primary-subtle);
  }

  .cycle-static {
    display: none;
  }

  @keyframes word {
    0% { opacity: 0; transform: translateY(40%); }
    4%, 22% { opacity: 1; transform: none; }
    26%, 100% { opacity: 0; transform: translateY(-40%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cycle { display: none; }
    .cycle-static { display: inline; }
  }
</style>
