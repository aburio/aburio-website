---
import { figures } from "../lib/site";
---

<div class="ticker">
  <ul class="ticker__track">
    {
      figures.map((figure) => (
        <li class="ticker__item">
          <span class="ticker__value">{figure.value}</span>
          <span class="muted">{figure.label}</span>
        </li>
      ))
    }
    {
      // A second copy makes the loop seamless; screen readers get the list once.
      figures.map((figure) => (
        <li class="ticker__item" aria-hidden="true">
          <span class="ticker__value">{figure.value}</span>
          <span class="muted">{figure.label}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .ticker {
    overflow: hidden;
    padding-block: 20px;
    border-block: 1px solid var(--divider);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: slide 44s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-inline: 28px;
    white-space: nowrap;
  }

  .ticker__value {
    font-size: var(--heading-size);
    line-height: var(--heading-line);
    font-weight: 700;
  }

  @keyframes slide {
    to { transform: translateX(-50%); }
  }

  /* Without motion the figures wrap onto lines instead of sliding. */
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      row-gap: var(--space-2);
      animation: none;
    }

    .ticker__item[aria-hidden="true"] {
      display: none;
    }
  }
</style>
