---
import { faLinkedin } from "@fortawesome/free-brands-svg-icons/faLinkedin";
import { faGithub } from "@fortawesome/free-brands-svg-icons/faGithub";
import { faEnvelope } from "@fortawesome/free-solid-svg-icons/faEnvelope";
import Button from "./Button.astro";
import { site } from "../lib/site";
---

<div class="contact-links">
  <Button href={site.linkedin} icon={faLinkedin} external>LinkedIn</Button>
  <Button href={site.github} icon={faGithub} variant="secondary" external>GitHub</Button>
  <Button href={`mailto:${site.email}`} icon={faEnvelope} variant="secondary">Email</Button>
</div>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
