---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image?: ImageMetadata;
  video?: string;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  // Shown only in dev so it is obvious which file to drop in.
  expected?: string;
  ratio?: string;
}

const { image, video, alt, widths, sizes, eager = false, expected, ratio = "16 / 9" } = Astro.props;
const showExpected = import.meta.env.DEV && expected;
---

<div class:list={["media", { "media--empty": !image }]} style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        widths={widths.filter((w) => w <= image.width)}
        sizes={sizes}
        formats={["avif", "webp"]}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    ) : (
      showExpected && <span class="media__expected">{expected}</span>
    )
  }
  {
    image && video && (
      <video
        class="media__video"
        data-src={video}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      />
    )
  }
</div>

<script>
  // Stills render first; the animated version only loads once the page is done
  // and the media is on screen, so it never competes with the first paint.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function startVideos() {
    if (reduceMotion.matches) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!video.src) {
              video.src = video.dataset.src ?? "";
              video.addEventListener("playing", () => video.classList.add("is-playing"), {
                once: true,
              });
            }
            // Autoplay can be refused (data saver, battery saver); the still stays visible.
            video.play().catch(() => {});
          } else if (video.src) {
            video.pause();
          }
        }
      },
      { rootMargin: "200px" },
    );
    document.querySelectorAll<HTMLVideoElement>("video[data-src]").forEach((v) => observer.observe(v));
  }

  if (document.readyState === "complete") startVideos();
  else window.addEventListener("load", startVideos, { once: true });
</script>

<style>
  .media {
    position: relative;
    align-self: start;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-strong);
  }

  .media :global(img),
  .media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media__video {
    visibility: hidden;
  }

  .media__video:global(.is-playing) {
    visibility: visible;
  }

  .media__expected {
    position: absolute;
    inset: auto var(--space-2) var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    word-break: break-all;
  }
</style>
